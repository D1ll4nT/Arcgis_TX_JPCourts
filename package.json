    "build:fixtures": "tsx scripts/build-fixtures.ts",
    "build:near-boundary": "tsx scripts/build-near-boundary.ts",
    "build:tiger": "tsx scripts/build-tiger.ts",
    "calibrate": "tsx scripts/calibrate.ts",
